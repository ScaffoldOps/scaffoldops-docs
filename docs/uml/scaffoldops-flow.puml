@startuml
actor Client
participant "generator-api" as API
queue Kafka
participant "generator-worker" as G
participant MinIO
participant "Docker Hub" as Hub
participant "deployment-worker" as D
participant Kubernetes as K
Client -> API: POST generation-requests
API -> Kafka: generation-requested
Kafka -> G: generation request
G -> API: GENERATING
G -> MinIO: project ZIP
G -> Hub: build and push image
G -> API: GENERATED with artifactRef and imageRef
(or GENERATION_FAILED with diagnostics)
Client -> API: POST id/deployment
API -> Kafka: deployment-requested
Kafka -> D: imageRef and namespace
D -> K: apply Deployment / Service, await rollout
D -> API: DEPLOYED or DEPLOYMENT_FAILED
Client -> API: DELETE id/deployment
API -> Kafka: undeployment-requested
Kafka -> D: undeploy
D -> K: delete owned resources
D -> API: NOT_DEPLOYED or DEPLOYMENT_FAILED
note over MinIO, Hub: Undeploy preserves artifact and image
Client -> API: DELETE generation-requests/id
API -> API: delete DB state
API -> Kafka: artifact-cleanup-requested
Kafka -> G: asset cleanup
G -> MinIO: remove artifact
G -> Hub: remove supported tag if enabled
G -> G: remove workspace
Kafka -> D: Kubernetes cleanup
D -> K: delete owned resources
@enduml
